# Backend: any OpenAI-compatible /chat/completions endpoint
BASE_API_URL=https://ollama.example.com/v1
API_KEY=sk-backend-secret

# Model sent to the backend, and optional aliases advertised by /v1/models
MODEL=beam:cloud
# MODEL_ALIASES=gpt-4o,assistant

# Client API keys come from Infisical: secret name = user id, secret value = client API key.
# Keys are loaded at startup and refreshed every TOKEN_REFRESH_MS; with none loaded the API
# fails closed with 503.
INFISICAL_BASE_URL=https://secrets.example.com
INFISICAL_CLIENT_ID=00000000-0000-0000-0000-000000000000
INFISICAL_CLIENT_SECRET=replace-me
INFISICAL_PROJECT_ID=00000000-0000-0000-0000-000000000000
INFISICAL_ENV=prod
INFISICAL_SECRET_PATH=users
# TOKEN_REFRESH_MS=60000

# Optional local fallback merged with Infisical (same "key:user" formats).
# ASSISTANT_API_KEYS=sk-pi-alice-0123456789abcdef:alice
# ASSISTANT_API_KEY=sk-pi-default-0123456789
# ASSISTANT_USER=default

PORT=8787
BIND_HOST=0.0.0.0
# Root for agent configs, memory, sessions, workspaces, and handoffs.
# Use an absolute path (e.g. /data) with a Docker volume.
BASEDIR=.
# AGENTS_DIR=agent
# AGENT_ID=default
# AGENT_DIR=agent/default
# CONTEXT_WINDOW=128000
# MAX_TOKENS=8192
# Estimated input-token cap per request; 0 or unset disables the check.
# MAX_INPUT_TOKENS=100000
# Auto-compaction trigger as a fraction of CONTEXT_WINDOW; 0 disables it.
# COMPACTION_THRESHOLD=0.75
# Recent conversation turns kept verbatim after compaction.
# COMPACTION_KEEP_TURNS=6
